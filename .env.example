# Container-/Runtime-Werte
# Fachliche Einstellungen wie Sync-Zeiten, Retries, Benachrichtigungsregeln,
# Kalender, Farben und Therapieplan-URLs stehen in data/config.yaml.

TZ=Europe/Berlin
VERBOSE=0

# Optional, falls Docker Compose sonst nicht deinen Linux-Benutzer verwendet.
# UID=1000
# GID=1000

# Secrets für Push-Provider.
# Die Provider selbst aktivierst du in data/config.yaml unter notifications.providers.*.enabled.
PUSHOVER_TOKEN=
PUSHOVER_USER=
PUSHOVER_DEVICE=

HOMEASSISTANT_TOKEN=

# Google OAuth Redirect für ./scripts/init-google-auth.sh
# Wichtig: GOOGLE_AUTH_HOST für Google-OAuth normalerweise auf localhost lassen.
# Keine private IP wie 192.168.x.x als GOOGLE_AUTH_HOST setzen.
GOOGLE_AUTH_HOST=localhost
GOOGLE_AUTH_BIND_ADDR=0.0.0.0
GOOGLE_AUTH_PORT=6080
GOOGLE_AUTH_PUBLISH_ADDR=127.0.0.1

# Wenn der Browser auf einem anderen Rechner läuft:
# Variante A: SSH-Tunnel verwenden und GOOGLE_AUTH_PUBLISH_ADDR=127.0.0.1 lassen.
#   ssh -L 6080:127.0.0.1:6080 benutzer@DOCKER_HOST_IP
# Variante B: Port im LAN freigeben, aber GOOGLE_AUTH_HOST=localhost lassen.
#   Nach der Google-Umleitung localhost im Browser manuell durch die Docker-Host-IP ersetzen.
# GOOGLE_AUTH_PUBLISH_ADDR=0.0.0.0

# Legacy/Notfall-Overrides:
# Ältere Versionen nutzen einzelne Einstellungen aus .env. Neue Versionen lesen diese
# Werte bevorzugt aus data/config.yaml. Diese Variablen nur setzen, wenn du bewusst
# alte Versionen betreibst oder einen temporären Override brauchst.
# SYNC_TIMES=07:30,10:00,12:00,18:00
# RUN_ON_START=0
# SYNC_RETRY_ENABLED=1
# SYNC_RETRY_MAX_ATTEMPTS=3
# SYNC_RETRY_DELAY_SECONDS=300
# NOTIFICATIONS_ENABLED=1
# PUSHOVER_ENABLED=1
