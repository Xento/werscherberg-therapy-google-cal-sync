TZ=Europe/Berlin
VERBOSE=0

# Bis zu vier Uhrzeiten im Format HH:MM oder HH:MM:SS, lokale Container-Zeitzone TZ.
SYNC_TIMES=07:30,10:00,12:00,18:00

# 1 = direkt beim Containerstart zusätzlich synchronisieren, danach nach Zeitplan.
RUN_ON_START=0

# Neuversuche nach einem geplanten Sync-Zeitpunkt.
# Standard: Wenn ein Lauf keine Änderungen findet oder Fehler enthält, bis zu 3 Neuversuche alle 5 Minuten.
SYNC_RETRY_ENABLED=1
SYNC_RETRY_MAX_ATTEMPTS=3
SYNC_RETRY_DELAY_SECONDS=300
SYNC_RETRY_WHEN_NO_CHANGES=1
SYNC_RETRY_WHEN_ERRORS=1
SYNC_STATS_FILE=/app/data/last_sync_stats.json

# Optional, falls Docker Compose sonst nicht deinen Linux-Benutzer verwendet.
# UID=1000
# GID=1000

# Pushbenachrichtigungen global aktivieren/deaktivieren.
NOTIFICATIONS_ENABLED=0
NOTIFY_ON_CHANGES=1
NOTIFY_ON_ERRORS=1
NOTIFY_ON_SUCCESS_NO_CHANGES=0
NOTIFICATION_TITLE_PREFIX=Therapieplan
# 1 = einzelne Termine in der Pushmeldung anzeigen, nicht nur Zähler.
NOTIFY_INCLUDE_CHANGE_DETAILS=1
# Maximale Anzahl einzelner Terminzeilen in einer Pushmeldung.
NOTIFY_MAX_CHANGE_ITEMS=12
# Pushover ist bei langen Nachrichten begrenzt. 950 ist ein sicherer Standardwert.
NOTIFY_MAX_MESSAGE_CHARS=950

# Eskalationslogik für geänderte/neue/abgesagte Termine:
# Stufe 0 = Terminänderungen für spätere Tage
# Stufe 1 = Terminänderungen am gleichen Kalendertag
# Stufe 2 = Terminänderungen im nächsten Abschnitt zwischen zwei Sync-Uhrzeiten
NOTIFY_INTENSE_SAME_DAY_CHANGES=1
NOTIFY_INTENSE_NEXT_SYNC_WINDOW_CHANGES=1

# Pushover-Stufe 0: normale Zukunftsänderungen.
PUSHOVER_LEVEL0_PRIORITY=0
PUSHOVER_LEVEL0_SOUND=pushover
PUSHOVER_LEVEL0_RETRY=60
PUSHOVER_LEVEL0_EXPIRE=1800

# Pushover-Stufe 1: Änderung am gleichen Tag.
PUSHOVER_LEVEL1_PRIORITY=1
PUSHOVER_LEVEL1_SOUND=persistent
PUSHOVER_LEVEL1_RETRY=60
PUSHOVER_LEVEL1_EXPIRE=1800

# Pushover-Stufe 2: Änderung im nächsten Abschnitt bis zum nächsten Sync-Zeitpunkt.
# 2 = Emergency bis zur Bestätigung. retry/expire werden nur bei Priority 2 genutzt.
PUSHOVER_LEVEL2_PRIORITY=2
PUSHOVER_LEVEL2_SOUND=echo
PUSHOVER_LEVEL2_RETRY=60
PUSHOVER_LEVEL2_EXPIRE=1800

# Legacy-Aliase für ältere Versionen. Neue Version nutzt PUSHOVER_LEVEL0/1/2_*.
PUSHOVER_PRIORITY=0
PUSHOVER_SOUND=pushover
PUSHOVER_INTENSE_PRIORITY=2
PUSHOVER_INTENSE_SOUND=echo
PUSHOVER_INTENSE_RETRY=60
PUSHOVER_INTENSE_EXPIRE=1800
PUSHOVER_SAME_DAY_PRIORITY=1
PUSHOVER_SAME_DAY_SOUND=persistent
PUSHOVER_SAME_DAY_RETRY=60
PUSHOVER_SAME_DAY_EXPIRE=1800

# Variante A: Pushover
PUSHOVER_ENABLED=0
PUSHOVER_TOKEN=
PUSHOVER_USER=
PUSHOVER_DEVICE=

# Variante B: Home Assistant Companion App / Notify-Service
HOMEASSISTANT_ENABLED=0
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=
# Beispiel: mobile_app_pixel_8 oder notify.mobile_app_pixel_8
HOMEASSISTANT_NOTIFY_SERVICE=

# Google OAuth Redirect für ./scripts/init-google-auth.sh
# Standard: Browser auf demselben Host -> http://localhost:6080/
GOOGLE_AUTH_HOST=localhost
GOOGLE_AUTH_BIND_ADDR=0.0.0.0
GOOGLE_AUTH_PORT=6080
GOOGLE_AUTH_PUBLISH_ADDR=127.0.0.1
# Wenn du den OAuth-Link von einem anderen Rechner öffnest:
# GOOGLE_AUTH_HOST=192.0.2.10
# GOOGLE_AUTH_PUBLISH_ADDR=0.0.0.0
